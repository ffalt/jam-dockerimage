JAM_ALLOWED_COOKIE_DOMAINS=http://localhost:4040
JAM_DATA_PATH=/home/node/jam/data/
JAM_DB_DIALECT=sqlite
JAM_DOMAIN=http://localhost:4040
JAM_FRONTEND_PATH=/home/node/jam/berry/
JAM_HOST=0.0.0.0
JAM_JWT_MAXAGE="1 day"
JAM_LOG_LEVEL=info
JAM_PORT=4040
JAM_SESSION_COOKIE_SECURE=true
JAM_SESSION_MAXAGE="1 day"
JAM_SESSION_TRUST_PROXY=true
JAM_MIN_PASSWORD_LENGTH=10
# JAM_JWT_SECRET and JAM_SESSION_SECRET are deliberately not set here: a value baked into the
# image would be identical in every pull. The deployment must supply 64+ random characters;
# jamserve refuses to start otherwise.
